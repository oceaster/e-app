{
  "name": "e-app",
  "version": "1.0.18",
  "description": "The private e-server desktop client",
  "main": "desktop/bootstrap.cjs",
  "type": "commonjs",
  "private": true,
  "author": "Easter LTD",
  "license": "UNLICENSED",
  "homepage": "https://easter.company/",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:navigation": "electron --no-sandbox scripts/navigation-smoke.cjs",
    "pack": "electron-builder --dir",
    "dist:linux": "electron-builder --linux AppImage deb pacman --x64 --publish never",
    "dist:windows": "electron-builder --win nsis --x64 --publish never",
    "test:servers": "electron --no-sandbox scripts/shell-servers.cjs"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ltd.easter.eserver",
    "productName": "e-server",
    "copyright": "Copyright \u00a9 2026 Easter LTD. All rights reserved.",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "!desktop/packaging/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "desktop/packaging/e-app-registry-stamp",
        "to": "e-app-registry-stamp"
      },
      {
        "from": "desktop/packaging/49-e-app-registry-stamp.rules",
        "to": "49-e-app-registry-stamp.rules"
      }
    ],
    "protocols": [
      {
        "name": "e-server connection",
        "schemes": [
          "e-server"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "category": "Network",
      "icon": "desktop/icon.png",
      "executableName": "e-server-client",
      "artifactName": "Easter-e-server-Linux-${arch}.${ext}",
      "maintainer": "Easter LTD",
      "synopsis": "Your private e-server desktop client"
    },
    "deb": {
      "afterInstall": "desktop/packaging/after-install.sh",
      "afterRemove": "desktop/packaging/after-remove.sh"
    },
    "pacman": {
      "depends": [
        "glibc",
        "gtk3",
        "nss",
        "nspr",
        "alsa-lib",
        "at-spi2-core",
        "cairo",
        "dbus",
        "expat",
        "glib2",
        "hicolor-icon-theme",
        "libcups",
        "libdrm",
        "libnotify",
        "libpulse",
        "libstdc++",
        "libx11",
        "libxcb",
        "libxcomposite",
        "libxdamage",
        "libxext",
        "libxfixes",
        "libxkbcommon",
        "libxrandr",
        "libxss",
        "mesa",
        "pango",
        "systemd-libs",
        "xdg-utils"
      ],
      "afterInstall": "desktop/packaging/after-install.sh",
      "afterRemove": "desktop/packaging/after-remove.sh"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/icon.png",
      "artifactName": "Easter-e-server-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "e-server"
    }
  }
}
