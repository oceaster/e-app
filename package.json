{
  "name": "e-app",
  "version": "1.0.58",
  "description": "e-server Desktop Client",
  "main": "desktop/bootstrap.cjs",
  "type": "commonjs",
  "private": true,
  "author": "Easter LTD",
  "license": "UNLICENSED",
  "homepage": "https://easter.company/",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:local-ai": "node scripts/build-local-ai.cjs",
    "test:navigation": "electron --no-sandbox scripts/navigation-smoke.cjs",
    "pack": "npm run build:local-ai && electron-builder --dir",
    "pack:debug": "npm run build:local-ai && node scripts/pack-debug.cjs",
    "dist:linux": "npm run build:local-ai && electron-builder --linux AppImage deb pacman --x64 --publish never",
    "dist:windows": "npm run build:local-ai && electron-builder --win nsis --x64 --publish never",
    "test:servers": "electron --no-sandbox scripts/shell-servers.cjs",
    "test:instances": "electron --no-sandbox tests/instance-menu-journey.cjs"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ltd.easter.eserver",
    "productName": "e-app",
    "copyright": "Copyright \u00a9 2026 Easter LTD. All rights reserved.",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "!desktop/local-ai/**",
      "!desktop/local-ai/src/**",
      "desktop/local-ai/dist/**",
      "desktop/local-ai/ATTRIBUTION.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "protocols": [
      {
        "name": "e-app connection",
        "schemes": [
          "e-server"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "category": "Network",
      "icon": "desktop/icon.png",
      "executableName": "e-server-client",
      "artifactName": "Easter-e-server-Linux-${arch}.${ext}",
      "maintainer": "Easter LTD",
      "synopsis": "e-server Desktop Client",
      "description": "e-app is the private e-server desktop client.",
      "desktop": {
        "entry": {
          "Name": "e-app",
          "GenericName": "e-server Desktop Client",
          "Comment": "The private e-server desktop client",
          "StartupWMClass": "e-app"
        }
      },
      "syncDesktopName": true
    },
    "pacman": {
      "depends": [
        "glibc",
        "gtk3",
        "nss",
        "nspr",
        "alsa-lib",
        "at-spi2-core",
        "cairo",
        "dbus",
        "expat",
        "glib2",
        "hicolor-icon-theme",
        "libcups",
        "libdrm",
        "libnotify",
        "libpulse",
        "libstdc++",
        "libx11",
        "libxcb",
        "libxcomposite",
        "libxdamage",
        "libxext",
        "libxfixes",
        "libxkbcommon",
        "libxrandr",
        "libxss",
        "mesa",
        "pango",
        "systemd-libs",
        "xdg-utils"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/icon.png",
      "artifactName": "Easter-e-server-Windows-${arch}.${ext}",
      "executableName": "e-server"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "e-app"
    }
  },
  "desktopName": "e-app.desktop"
}
